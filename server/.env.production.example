# =============================================================================
# Backend - Production Environment (Cloud Run)
# =============================================================================
# Set these in Cloud Run environment variables or Secret Manager.
# NEVER commit actual values to version control.
# =============================================================================

# Server
PORT=8080
NODE_ENV=production

# CORS — must match your frontend hosting URL
# Supports comma-separated values for multiple origins (e.g. custom domain + default)
# Firebase:  FRONTEND_URL=https://your-project-id.web.app
# Vercel:    FRONTEND_URL=https://your-app.vercel.app
# Multiple:  FRONTEND_URL=https://your-project-id.web.app,https://your-custom-domain.com
FRONTEND_URL=https://your-project-id.web.app

# API
API_VERSION=v1

# PDF Generation
PDF_METHOD=puppeteer
LATEX_TIMEOUT=30000
TEMP_DIR=/tmp/resume-builder

# AI (store in Secret Manager)
GEMINI_API_KEY=your_gemini_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Database (optional)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/resume-builder
