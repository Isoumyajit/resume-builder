# =============================================================================
# Frontend - Production Environment
# =============================================================================
# For Firebase Hosting: create .env.production, then run npm run deploy:frontend
# For Vercel: add these as Environment Variables in the Vercel dashboard
# =============================================================================

# Backend API — your Cloud Run URL
VITE_API_URL=https://resume-builder-backend-xxx.run.app
VITE_API_VERSION=v1
VITE_NODE_ENV=production

# Feature Flags
VITE_ENABLE_API_LOGS=false
VITE_ENABLE_HEALTH_CHECK=true
VITE_ENABLE_AUTO_SAVE=true

# PDF Settings
VITE_DEFAULT_PDF_NAME=resume.pdf
VITE_PDF_TIMEOUT=30000

# Debug (disable in production)
VITE_DEBUG_MODE=false

# Firebase Configuration (required regardless of hosting platform)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
